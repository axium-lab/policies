{
  "name": "@axium-lab/policies",
  "version": "0.1.3",
  "description": "Isomorphic, schema-driven validation and composition of versioned policy documents",
  "license": "MIT",
  "author": "Axium Lab",
  "contributors": [
    "Luis Peris",
    "Pedro Losas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axium-lab/policies.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/check-dist.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manual": "vitest run tests/manual.test.ts"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "zod": "^4.6.5"
  }
}
